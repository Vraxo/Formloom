<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Formloom.BlenderCube</AssemblyName>
    <RootNamespace>Formloom.BlenderCube</RootNamespace>
  </PropertyGroup>

  <Target Name="CopyBlenderPythonModules" AfterTargets="Build">
    <ItemGroup>
      <BlenderPythonModule Include="$(MSBuildProjectDirectory)/*.py" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BlenderPythonModule)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
