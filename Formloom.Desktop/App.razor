@inject GenerationService Generator
@inject PngSaveService Saver

<main>
    <header>
        <span class="brand">Formloom<span class="brand-dot">.</span></span>
        <span class="badge">CPU · PROCEDURAL · NO ML</span>
    </header>
    <div class="workspace">
        <section class="controls" aria-labelledby="create-title">
            <p class="eyebrow">THE STILL-LIFE STUDY</p>
            <h1 id="create-title">Shape.<br />Material. Light.</h1>
            <p class="intro">An image, constructed from geometry and code. Yours to vary.</p>
            <form @onsubmit="GenerateAsync" @onsubmit:preventDefault>
                <fieldset disabled="@IsBusy">
                    <label for="prompt">Describe your still life</label>
                    <textarea id="prompt" rows="3" @bind="prompt" @bind:event="oninput" aria-describedby="prompt-help"></textarea>
                    <p id="prompt-help" class="help">Try a red, green or yellow apple on a wooden table.</p>
                    <div class="label-row">
                        <label for="seed">Seed</label>
                        <button type="button" class="text-button" @onclick="RandomizeSeed">Randomize</button>
                    </div>
                    <input id="seed" type="text" inputmode="numeric" @bind="seedText" @bind:event="oninput" aria-describedby="seed-help" />
                    <p id="seed-help" class="help">Same inputs, same image. Use a whole number from 0 to 18446744073709551615.</p>
                    <div class="label-row">
                        <label for="variation">Variation</label>
                        <output for="variation">@variation.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)</output>
                    </div>
                    <input id="variation" type="range" min="0" max="1" step="0.01" @bind="variation" @bind:event="oninput" />
                    <p class="help">Subtle at the left. More organic at the right.</p>
                    <button class="primary" type="submit">@(generating ? "Generating…" : "Generate image") <span aria-hidden="true">↗</span></button>
                </fieldset>
            </form>
            <p class="specification">1024 × 1024 · PNG · CPU raster</p>
        </section>
        <section class="image-panel" aria-label="Generated image" aria-busy="@generating">
            <div class="preview">
                @if (previewUrl is not null)
                {
                    <img src="@previewUrl" alt="@imageDescription" width="1024" height="1024" />
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-mark" aria-hidden="true">◌</span>
                        <h2>A little space for possibility.</h2>
                        <p>Generate your first still life.<br />No models. No downloaded textures. Just a seed.</p>
                    </div>
                }
            </div>
            <div class="preview-footer">
                <p>@(image is null ? "Your first study is waiting." : $"Seed {renderedSeed} · Variation {renderedVariation:P0}")</p>
                <button type="button" class="secondary" disabled="@(image is null || IsBusy)" @onclick="SaveAsync">@(saving ? "Saving…" : "Save PNG")</button>
            </div>
        </section>
    </div>
    @if (error is not null)
    {
        <p class="message error" role="alert">@error</p>
    }
    <p class="message" role="status" aria-live="polite">@status</p>
    <footer>BUILT FROM FIRST PRINCIPLES <span>One apple. Infinite small differences.</span></footer>
</main>
