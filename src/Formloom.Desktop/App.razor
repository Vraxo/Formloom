@inject DesktopSession Session

<main>
    <header>
        <span class="brand">Formloom<span class="brand-dot">.</span></span>
        <span class="badge">CPU · PROCEDURAL · NO ML</span>
    </header>
    <div class="workspace">
        <section class="controls" aria-labelledby="create-title">
            <p class="eyebrow">THE STILL-LIFE STUDY</p>
            <h1 id="create-title">Shape.<br />Material. Light.</h1>
            <p class="intro">An image, constructed from geometry and code. Yours to vary.</p>
            <form @onsubmit="Session.GenerateAsync" @onsubmit:preventDefault>
                <fieldset disabled="@Session.IsBusy">
                    <label for="prompt">Describe your still life</label>
                    <textarea id="prompt" rows="3" @bind="Session.Prompt" @bind:event="oninput" aria-describedby="prompt-help"></textarea>
                    <p id="prompt-help" class="help">Use one to three objects on a wooden table, or place one fruit inside a bowl. Try a red apple and a green pear on a wooden table, a cream ceramic cup and an orange on a wooden table, a red apple in a blue ceramic bowl on a wooden table, or a blue ceramic cup filled with coffee on a wooden table.</p>
                    <div class="label-row">
                        <label for="seed">Seed</label>
                        <button type="button" class="text-button" @onclick="Session.RandomizeSeed">Randomize</button>
                    </div>
                    <input id="seed" type="text" inputmode="numeric" @bind="Session.SeedText" @bind:event="oninput" aria-describedby="seed-help" />
                    <p id="seed-help" class="help">Same inputs, same image. Use a whole number from 0 to 18446744073709551615.</p>
                    <div class="label-row">
                        <label for="variation">Variation</label>
                        <output for="variation">@Session.Variation.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)</output>
                    </div>
                    <input id="variation" type="range" min="0" max="1" step="0.01" @bind="Session.Variation" @bind:event="oninput" />
                    <p class="help">Subtle at the left. More organic at the right.</p>
                    <button class="primary" type="submit">@(Session.Generating ? "Generating…" : "Generate image") <span aria-hidden="true">↗</span></button>
                </fieldset>
            </form>
            <p class="specification">1024 × 1024 · PNG · CPU raster</p>
        </section>
        <section class="image-panel" aria-label="Generated image" aria-busy="@Session.Generating">
            <div class="preview">
                @if (Session.PreviewUrl is not null)
                {
                    <img src="@Session.PreviewUrl" alt="@Session.ImageDescription" width="1024" height="1024" />
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-mark" aria-hidden="true">◌</span>
                        <h2>A little space for possibility.</h2>
                        <p>Generate your first still life.<br />No models. No downloaded textures. Just a seed.</p>
                    </div>
                }
            </div>
            <div class="preview-footer">
                <p>@(Session.Image is null ? "Your first study is waiting." : $"Seed {Session.RenderedSeed} · Variation {Session.RenderedVariation:P0}")</p>
                <button type="button" class="secondary" disabled="@(Session.Image is null || Session.IsBusy)" @onclick="Session.SaveAsync">@(Session.Saving ? "Saving…" : "Save PNG")</button>
            </div>
        </section>
    </div>
    @if (Session.Error is not null)
    {
        <p class="message error" role="alert">@Session.Error</p>
    }
    <p class="message" role="status" aria-live="polite">@Session.Status</p>
    <footer>BUILT FROM FIRST PRINCIPLES <span>Fruit and ceramic. Infinite small differences.</span></footer>
</main>
